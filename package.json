{
  "name": "shadow-hunter",
  "version": "1.0.0",
  "description": "Stealth shooter with LAN team battles",
  "author": "Shadow Hunter",
  "private": true,
  "main": "electron-main.js",
  "scripts": { "start": "node server.js" },
  "devDependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.shadowhunter",
    "productName": "Shadow Hunter",
    "files": ["electron-main.js", "server.js", "www/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": "portable" }
  }
}
